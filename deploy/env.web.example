# Web build + Vercel — copy to deploy/.env.web (staging / previews) and deploy/.env.web.prod (production). Git-ignored; chmod 600.
# Used by deploy/vercel_deploy.sh (it parses this file, never executes it). Values are never printed.

# ── Supabase (Settings → API) — PUBLIC values that end up in the browser ──────────────────────────────────────────────
DRUGBOX_SUPABASE_URL="https://<project-ref>.supabase.co"
# The "anon public" key. NEVER the service_role key (the build refuses any key whose role is not anon).
DRUGBOX_SUPABASE_ANON_KEY="eyJ…"

# ── Sentry (optional) — Settings → Projects → <project> → Loader Script: the URL only ──────────────────────────────────
# When set, the loader is the first script in <head> and the CSP allows js*.sentry-cdn.com, browser.sentry-cdn.com and
# https://*.sentry.io (event ingest); when empty, neither the script nor those hosts are in the build.
DRUGBOX_SENTRY_LOADER=""

# ── Vercel — secrets for the CLI (passed in the environment, never on the command line) ───────────────────────────────
# Account → Settings → Tokens (scope: the Drugbox team).
VERCEL_TOKEN=""
# Project → Settings → General: "Team ID" (team_…) and "Project ID" (prj_…).
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""

# ── Safety ────────────────────────────────────────────────────────────────────────────────────────────────────────────
# REQUIRED — the PRODUCTION Supabase project's ref. A build against it is refused without --prod; --prod against any other is refused.
SUPABASE_PROD_REF=""
