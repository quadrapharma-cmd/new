# Edge Function secrets — copy to deploy/.env.functions (staging: TEST keys) and deploy/.env.functions.prod (production: LIVE keys).
# Those copies are git-ignored; keep them chmod 600. deploy/supabase_deploy.sh checks this file (placeholders, test-vs-live keys,
# Fawry staging vs production) and sends it with `supabase secrets set --env-file …` — values are never printed.
# Quote values that contain spaces or "#".
#
# NOT here: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY — Supabase injects them into every function itself
# (names starting with SUPABASE_ are reserved; the script refuses them). The service-role key never leaves Supabase.

# ── The web app ───────────────────────────────────────────────────────────────────────────────────────────────────────
# Where the browser comes back after paying (Paymob redirection_url = APP_URL?payment=<order id>). The address of THIS environment.
APP_URL="https://staging.drugbox.app/"
# Browser origins allowed to call payments-create (comma-separated, no paths). List every address the app is opened from
# (the Vercel preview/production domain AND your own domain). If empty, the origin of APP_URL is used.
ALLOWED_ORIGINS="https://staging.drugbox.app"

# ── Paymob (card + mobile wallets) — dashboard → Settings / Developers ─────────────────────────────────────────────────
# Secret key (egy_sk_test_… for staging, egy_sk_live_… for production) — server only.
PAYMOB_SECRET_KEY="egy_sk_test_CHANGE_ME"
# Public key (egy_pk_test_… / egy_pk_live_…) — used to open Unified Checkout.
PAYMOB_PUBLIC_KEY="egy_pk_test_CHANGE_ME"
# HMAC secret (profile → HMAC) — verifies the transaction-processed callback (HMAC-SHA512).
PAYMOB_HMAC_SECRET="CHANGE_ME"
# Integration ids (numbers): the card integration and the mobile-wallet integration (Vodafone Cash, Orange, e& money, WE Pay).
PAYMOB_CARD_INTEGRATION_ID="CHANGE_ME"
PAYMOB_WALLET_INTEGRATION_ID="CHANGE_ME"
# Optional: Paymob API base (default https://accept.paymob.com).
# PAYMOB_BASE="https://accept.paymob.com"

# ── Fawry (FawryPay reference numbers) ─────────────────────────────────────────────────────────────────────────────────
# Staging MUST point at Fawry's staging server; production leaves it out (default https://www.atfawry.com) — the script checks both.
FAWRY_BASE="https://atfawry.fawrystaging.com"
FAWRY_MERCHANT_CODE="CHANGE_ME"
# Secure key — signs the charge request and verifies the server notification V2 (SHA-256).
FAWRY_SECURE_KEY="CHANGE_ME"

# ── InstaPay (manual: transfer + receipt, confirmed in Admin → Review → Payments) ──────────────────────────────────────
INSTAPAY_ADDRESS="CHANGE_ME@instapay"
INSTAPAY_NAME="Drugbox"

# ── Optional ──────────────────────────────────────────────────────────────────────────────────────────────────────────
# The functions' public base URL (default ${SUPABASE_URL}/functions/v1) — only if you put a custom domain in front.
# FUNCTIONS_URL="https://<ref>.supabase.co/functions/v1"
