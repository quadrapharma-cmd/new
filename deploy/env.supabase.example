# Database + Supabase CLI access — copy to deploy/.env.supabase (staging) and deploy/.env.supabase.prod (production).
# Git-ignored; chmod 600. Used by deploy/supabase_deploy.sh and deploy/backup.sh (parsed, never executed; values never printed).

# The project's ref: the <ref> in https://<ref>.supabase.co (Settings → General → Reference ID).
SUPABASE_PROJECT_REF=""
# EITHER the full connection string (Settings → Database → Connection string → URI; port 5432 — NOT the 6543 transaction pooler) …
SUPABASE_DB_URL=""
# … OR the database password (the script then uses postgres@db.<ref>.supabase.co:5432). That direct host is IPv6-only; on an
# IPv4-only network use the Session pooler instead: SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com, SUPABASE_DB_USER=postgres.<ref>
SUPABASE_DB_PASSWORD=""
# SUPABASE_DB_HOST=""
# SUPABASE_DB_USER=""
# SUPABASE_DB_PORT="5432"

# Personal access token for the Supabase CLI (supabase.com → Account → Access Tokens): function secrets + deploys.
SUPABASE_ACCESS_TOKEN=""

# REQUIRED — the PRODUCTION project's ref (same value in staging and production files): protects production from a staging run.
# The scripts refuse to touch any Supabase project while it is empty.
SUPABASE_PROD_REF=""

# ── Backups (deploy/backup.sh) ─────────────────────────────────────────────────────────────────────────────────────────
# The encryption key FILE (create: deploy/backup.sh --gen-key ~/.drugbox-backup.key — and keep a copy offline).
DRUGBOX_BACKUP_KEY_FILE=""
# BACKUP_DIR="deploy/backups"
# BACKUP_RETENTION="8"
# For --restore-drill: an EMPTY scratch database (another server or a throw-away project — never this one).
# DRILL_DB_URL=""
