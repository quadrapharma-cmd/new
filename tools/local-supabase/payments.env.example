# Local payment settings (tests only — no real keys). start-payments.sh reads this file when it is given no other one.
# The Supabase keys are not here: start-payments.sh signs them with the running local stack's secret.
# For a real project the same names are Supabase function secrets (supabase secrets set …) — never a file in git.
PAYMOB_PUBLIC_KEY="egy_pk_test_local"
PAYMOB_SECRET_KEY="egy_sk_test_local"
PAYMOB_HMAC_SECRET="local-paymob-hmac-secret-for-tests-only"
PAYMOB_CARD_INTEGRATION_ID="111111"
PAYMOB_WALLET_INTEGRATION_ID="222222"
FAWRY_MERCHANT_CODE="local-merchant"
FAWRY_SECURE_KEY="local-fawry-secure-key-for-tests-only"
INSTAPAY_ADDRESS="drugbox@instapay"
INSTAPAY_NAME="Drugbox"
# E-mails (notify-dispatch): the provider, its key and sender; the scheduler's secret. Local stand-in = Resend's API on the mock port.
EMAIL_PROVIDER="resend"
EMAIL_API_KEY="local-email-key-for-tests-only"
EMAIL_FROM="Drugbox <no-reply@drugbox.app>"
NOTIFY_DISPATCH_SECRET="local-dispatch-secret-for-tests-only"
# Phone verification codes (sms-dispatch, w-trust 0093): the SMS provider, its account and sender; the scheduler's secret. Local stand-in = Twilio's API.
SMS_PROVIDER="twilio"
SMS_ACCOUNT="ACLOCALTESTONLY"
SMS_TOKEN="local-sms-token-for-tests-only"
SMS_FROM="Drugbox"
SMS_DISPATCH_SECRET="local-sms-dispatch-secret-for-tests-only"
# Optional (defaults below are the local stand-ins started by start-payments.sh / start.sh):
# PAYMOB_BASE="http://127.0.0.1:54500"  FAWRY_BASE="http://127.0.0.1:54500"
# SUPABASE_URL="http://127.0.0.1:54321"  FUNCTIONS_URL="http://localhost:54321/functions/v1"  APP_URL="http://localhost:54321/"
# SUPABASE_ANON_KEY="…"  SUPABASE_SERVICE_ROLE_KEY="…"  ALLOWED_ORIGINS="http://localhost:54321"
