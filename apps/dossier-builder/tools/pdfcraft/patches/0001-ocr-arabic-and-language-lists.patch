+/// A right-to-left letter: Hebrew, Arabic (with Syriac, Thaana, NKo, Samaritan, Mandaic and the Arabic extensions) and their
+/// presentation forms.
+fn is_rtl(c: char) -> bool {
+    matches!(c as u32, 0x0590..=0x08FF | 0xFB1D..=0xFDFF | 0xFE70..=0xFEFF)
+}
+
+/// The characters of one recognised word in the order they stand on the page, left to right. A word with a right-to-left letter
+/// is written right to left: its pieces in reverse, each Arabic or Hebrew piece reversed, its numbers and Latin letters left to
+/// right inside it (as the Unicode bidirectional algorithm lays out a word). Any other word is as it was read.
+fn visual_order(text: &str) -> Vec<char> {
+    let chars: Vec<char> = text.chars().collect();
+    if !chars.iter().any(|&c| is_rtl(c)) {
+        return chars;
+    }
+    let ltr = |c: char| c.is_ascii_alphanumeric() || matches!(c as u32, 0x0660..=0x0669 | 0x06F0..=0x06F9);
+    let mut runs: Vec<(bool, Vec<char>)> = Vec::new();
+    for c in chars {
+        let l = ltr(c);
+        let neutral = !l && !is_rtl(c);
+        match runs.last_mut() {
+            Some((kind, run)) if *kind == l || neutral => run.push(c),
+            _ => runs.push((l, vec![c])),
+        }
+    }
+    runs.reverse();
+    runs.into_iter().flat_map(|(l, run)| if l { run } else { run.into_iter().rev().collect() }).collect()
+}
