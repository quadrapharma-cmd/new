+/// A language list for Tesseract: codes joined by `+` («ar+en», read as Arabic and English together), each one mapped by
+/// [`language_code`]'s allow-list; a part it does not know is dropped (never passed on), repeats are read once, and an empty
+/// result is `"eng"`. Only allow-listed names ever reach the process.
+pub fn languages_code(code: &str) -> String {
+    let mut out: Vec<&'static str> = Vec::new();
+    for part in code.split('+') {
+        let c = part.trim().to_ascii_lowercase();
+        if let Some((_, v)) = LANGUAGE_CODES.iter().find(|(k, _)| *k == c) {
+            if !out.contains(v) {
+                out.push(v);
+            }
+        }
+    }
+    if out.is_empty() { "eng".to_string() } else { out.join("+") }
+}
