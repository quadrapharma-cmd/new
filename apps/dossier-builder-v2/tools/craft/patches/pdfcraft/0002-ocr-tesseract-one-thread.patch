+    /// Tesseract runs on one thread unless the caller says otherwise (several readings at once
+    /// each taking every core slowed each other to a standstill). Unix: a fake `tesseract` script
+    /// that writes down the limit it was given.
+    #[cfg(unix)]
+    #[test]
+    fn tesseract_runs_on_one_thread_unless_the_caller_says_otherwise() {
+        let dir = TempDir::create().unwrap();
+        let script = dir.path.join("tesseract-threads");
+        std::fs::write(dir.path.join("reading.tsv"), "5\t1\t1\t1\t1\t1\t0\t0\t1\t1\t95\tword\n").unwrap();
+        std::fs::write(
+            &script,
+            "#!/bin/sh\nprintf '%s' \"$OMP_THREAD_LIMIT\" > \"$(dirname \"$0\")/threads.txt\"\ncat \"$(dirname \"$0\")/reading.tsv\"\n",
+        )
+        .unwrap();
+        make_executable(&script);
+        let _ = TesseractCli::new(script).recognize(&blot(8, 8, 0, 0, 4, 4), &RecognizeOptions::default());
+        let want = std::env::var("OMP_THREAD_LIMIT").unwrap_or_else(|_| "1".into());
+        assert_eq!(std::fs::read_to_string(dir.path.join("threads.txt")).unwrap(), want);
+    }
